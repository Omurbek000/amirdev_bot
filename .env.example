# Скопируйте этот файл в .env и заполните значения.

# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Ваш Telegram ID (узнать у @userinfobot). Можно несколько через запятую.
ADMIN_IDS=123456789

# Брендинг и ссылки
STUDIO_NAME=AmirDev
SITE_URL=https://example.com
CONTACT_INFO=📱 Telegram: @amirdev\n📞 Телефон: +7 000 000-00-00

# Поведение
SESSION_TIMEOUT_MIN=30
# Минимальный интервал между заявками от одного пользователя (секунды).
RATE_LIMIT_COOLDOWN_SEC=300
ANALYTICS_FILE=analytics.log

# FSM / хранилище состояний (redis://... или пусто — MemoryStorage)
REDIS_URL=

# Каталог для SQLite-базы и аналитики (на Bothost задаётся автоматически)
DATA_DIR=data
